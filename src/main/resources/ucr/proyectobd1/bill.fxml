                                        <TextField fx:id="lblPoints" prefHeight="35.0" prefWidth="165.0" />
                                        <Label text="Descuentos:" />
                              <TextField fx:id="lblDiscount" prefHeight="35.0" prefWidth="158.0" />
                                    </children>
                                    <padding>
                                        <Insets bottom="5.0" />
                                    </padding>
                                </HBox>
                        <HBox prefHeight="100.0" prefWidth="200.0">
