                                        <Label prefHeight="17.0" prefWidth="70.0" text="Impuestos" />
                                        <TextField fx:id="lblTax" prefHeight="35.0" prefWidth="166.0" />
                                    </children>
                                    <padding>
                                        <Insets bottom="5.0" />
                                    </padding>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" prefHeight="42.0" prefWidth="770.0" spacing="20.0">
                                    <children>
                                        <Label prefWidth="69.0" text="Estado: " />
