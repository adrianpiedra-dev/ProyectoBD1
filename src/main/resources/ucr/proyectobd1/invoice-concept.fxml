<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="850.0" styleClass="root-container" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ucr.proyectobd1.controller.InvoiceConceptController">
   <children>
      <VBox prefHeight="630.0" prefWidth="830.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="65.0" prefWidth="772.0" spacing="100.0">
               <children>
                  <ImageView fx:id="imageviewLogo" fitHeight="150.0" fitWidth="193.0" pickOnBounds="true" preserveRatio="true" />
                  <Label alignment="CENTER" prefHeight="44.0" prefWidth="400.0" styleClass="label-header" text="CRUD CONCEPTOS FACTURA" />
                  <Button fx:id="btnBackMenu" mnemonicParsing="false" prefHeight="33.0" prefWidth="98.0" text="Volver" />
               </children>
            </HBox>
            <VBox prefHeight="530.0" prefWidth="675.0" spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox prefHeight="100.0" prefWidth="100.0" spacing="10.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="35.0" prefWidth="780.0" spacing="15.0">
                           <children>
                              <Label minWidth="120.0" prefHeight="17.0" text="Factura:" />
                              <TextField fx:id="txtInvoiceNumber" prefHeight="30.0" prefWidth="200.0" />
                              <Label minWidth="120.0" prefHeight="17.0" text="Descripción:" />
                              <TextField fx:id="txtDescription" prefHeight="30.0" prefWidth="250.0" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" prefHeight="35.0" prefWidth="780.0" spacing="15.0">
                           <children>
                              <Label minWidth="120.0" prefHeight="17.0" text="Monto:" />
                              <TextField fx:id="txtAmount" prefHeight="30.0" prefWidth="150.0" />
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
                  <HBox alignment="CENTER" prefHeight="50.0" prefWidth="200.0" spacing="10.0">
                     <children>
                        <Button fx:id="btnNew" mnemonicParsing="false" prefHeight="33.0" prefWidth="100.0" text="Nuevo" />
                        <Button fx:id="btnSave" mnemonicParsing="false" prefHeight="33.0" prefWidth="100.0" text="Guardar" />
                        <Button fx:id="btnDelete" mnemonicParsing="false" prefHeight="33.0" prefWidth="100.0" text="Eliminar" />
                        <Button fx:id="btnSearch" mnemonicParsing="false" prefHeight="33.0" prefWidth="100.0" text="Buscar" />
                        <Button fx:id="btnClear" mnemonicParsing="false" prefHeight="33.0" prefWidth="100.0" text="Limpiar" />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </HBox>
                  <Label fx:id="lblError" prefHeight="17.0" prefWidth="200.0" styleClass="label-error" text="" textFill="#ff0000" />
                  <TableView fx:id="tableviewConcepts" prefHeight="300.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="columnInvoiceNumber" prefWidth="150.0" text="Factura" />
                        <TableColumn fx:id="columnDescription" prefWidth="350.0" text="Descripción" />
                        <TableColumn fx:id="columnAmount" prefWidth="150.0" text="Monto" />
                     </columns>
                  </TableView>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
