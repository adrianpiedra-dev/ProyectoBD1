<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ucr.proyectobd1.controller.LocalitiesController">
   <children>
      <VBox prefHeight="400.0" prefWidth="600.0">
         <children>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" styleClass="label-header">
               <children>
                  <Label prefHeight="17.0" prefWidth="484.0" styleClass="label-header" text="CRUD Localidades" />
                  <Button fx:id="btnBackMenu" mnemonicParsing="false" text="Volver" textAlignment="RIGHT" />
               </children>
            </HBox>
            <TabPane prefHeight="379.0" prefWidth="600.0" tabClosingPolicy="UNAVAILABLE">
              <tabs>
                <Tab text="Crear Cantón">
                  <content>
                    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                           <children>
                              <VBox alignment="CENTER" layoutX="7.0" prefHeight="312.0" prefWidth="600.0">
                                 <children>
                                    <HBox alignment="CENTER" prefHeight="37.0" prefWidth="600.0">
                                       <children>
                                          <Label prefHeight="17.0" prefWidth="65.0" text="ID: " />
                                          <TextField fx:id="txtIdCanton" prefHeight="25.0" prefWidth="153.0" styleClass="text-field" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER" prefHeight="39.0" prefWidth="600.0">
                                       <children>
                                          <Label prefHeight="17.0" prefWidth="64.0" text="Nombre: " />
                                          <TextField fx:id="txtNameCanton" prefHeight="25.0" prefWidth="155.0" styleClass="text-field" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER" prefHeight="55.0" prefWidth="600.0">
                                       <children>
                                          <Label prefHeight="17.0" prefWidth="65.0" text="Provincia:" />
                                          <TextField fx:id="txtProvince" prefHeight="25.0" prefWidth="155.0" styleClass="text-field" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="BOTTOM_CENTER" prefHeight="66.0" prefWidth="590.0" spacing="20.0">
                                       <children>
                                          <Button fx:id="btnCleanCanton" mnemonicParsing="false" prefHeight="25.0" prefWidth="80.0" text="Borrar" />
                                          <Button fx:id="btnCreateCanton" mnemonicParsing="false" prefHeight="25.0" prefWidth="78.0" text="Crear" />
                                       </children>
                                       <padding>
                                          <Insets left="20.0" right="15.0" />
                                       </padding>
                                    </HBox>
                                    <Label fx:id="lblErrorCanton" alignment="CENTER" contentDisplay="CENTER" prefHeight="37.0" prefWidth="529.0" textAlignment="CENTER" textFill="#b92626">
                                       <padding>
                                          <Insets top="20.0" />
                                       </padding>
                                    </Label>
                                 </children>
                                 <padding>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </padding>
                              </VBox>
                           </children>
                        </AnchorPane>
                  </content>
                </Tab>
                <Tab text="Eliminar Cantón">
                  <content>
                    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                           <children>
                              <VBox layoutX="2.0" prefHeight="310.0" prefWidth="600.0">
                                 <children>
                                    <HBox alignment="CENTER" prefHeight="113.0" prefWidth="600.0">
                                       <children>
                                          <Label text="Codigo del Cantón: " />
                                          <TextField fx:id="txtCodeCantonDelete" styleClass="text-field" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER" prefHeight="45.0" prefWidth="600.0" spacing="20.0">
                                       <children>
                                          <Button fx:id="btnCleanDC" mnemonicParsing="false" prefHeight="25.0" prefWidth="89.0" text="Limpiar" />
                                          <Button fx:id="btnDeleteCanton" mnemonicParsing="false" prefHeight="25.0" prefWidth="85.0" text="Eliminar" />
                                       </children>
                                    </HBox>
                                    <HBox prefHeight="100.0" prefWidth="200.0">
                                       <children>
                                          <Label fx:id="lblErrorDeleteCanton" alignment="CENTER" contentDisplay="CENTER" prefHeight="119.0" prefWidth="596.0" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </AnchorPane>
                  </content>
                </Tab>
                  <Tab text="Buscar Cantón">
                    <content>
                      <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                           <children>
                              <VBox layoutY="7.0" prefHeight="290.0" prefWidth="600.0">
                                 <children>
                                    <HBox alignment="CENTER" prefHeight="76.0" prefWidth="600.0" spacing="10.0">
                                       <children>
                                          <Label prefHeight="17.0" prefWidth="116.0" text="Código del Cantón: " />
                                          <TextField fx:id="txtCodCantonSearch" styleClass="text-field" />
                                          <Button fx:id="btnSearchCanton" mnemonicParsing="false" text="Buscar" />
                                          <Button fx:id="btnCleanCantonSearch" mnemonicParsing="false" text="Limpiar" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                                       <children>
                                          <TextArea fx:id="txtResultCantonSearch" editable="false" prefHeight="100.0" prefWidth="343.0" styleClass="text-area" />
                                       </children>
                                    </HBox>
                                    <HBox prefHeight="100.0" prefWidth="200.0">
                                       <children>
                                          <Label fx:id="lblErrorSearchCanton" alignment="CENTER" prefHeight="106.0" prefWidth="600.0" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </AnchorPane>
                    </content>
                  </Tab>
                  <Tab text="Crear Distrito">
                    <content>
                      <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
                    </content>
                  </Tab>
                  <Tab text="Eliminar Distrito">
                    <content>
                      <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
                    </content>
                  </Tab>
                  <Tab text="Buscar Distrito">
                    <content>
                      <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
                    </content>
                  </Tab>
              </tabs>
            </TabPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
