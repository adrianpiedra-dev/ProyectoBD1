<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="850.0" styleClass="root-container" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ucr.proyectobd1.controller.TypePromotionController">
    <children>
        <VBox prefHeight="630.0" prefWidth="830.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="65.0" prefWidth="772.0" spacing="70.0">
                    <children>
                        <ImageView fx:id="imageviewLogo" fitHeight="150.0" fitWidth="193.0" pickOnBounds="true" preserveRatio="true" />
                        <Label alignment="CENTER" prefHeight="44.0" prefWidth="385.0" styleClass="label-header" text="CRUD TIPO DE PROMOCIÓN" />
                        <Button fx:id="btnBackMenu" mnemonicParsing="false" prefHeight="33.0" prefWidth="88.0" text="Volver" />
                    </children>
                </HBox>
                <VBox prefHeight="440.0" prefWidth="948.0" spacing="15.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT" prefHeight="200.0" prefWidth="100.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" prefHeight="42.0" prefWidth="770.0" spacing="20.0">
                                    <children>
                                        <Label text="Código" />
                                        <TextField fx:id="lblCode" prefHeight="35.0" prefWidth="119.0" />
                                        <Label text="Porcentaje M" />
                                        <TextField fx:id="lblPercentage" />
                                        <Label prefHeight="17.0" prefWidth="104.0" text="Incompatibilidad" />
                              <ComboBox fx:id="comboboxIncompatibilities" prefWidth="150.0" />
                                    </children>
                                    <padding>
                                        <Insets bottom="5.0" />
                                    </padding>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" prefHeight="42.0" prefWidth="770.0" spacing="20.0">
                                    <padding>
                                        <Insets bottom="5.0" />
                                    </padding>
                                </HBox>
                            </children>
                        </VBox>
                        <HBox alignment="CENTER" prefHeight="50.0" prefWidth="200.0" spacing="10.0">
                            <children>
                                <Button fx:id="btnSave" mnemonicParsing="false" prefHeight="33.0" prefWidth="100.0" text="Crear" />
                                <Button fx:id="btnDelete" mnemonicParsing="false" prefHeight="33.0" prefWidth="100.0" text="Eliminar" />
                        <Button fx:id="btnSearch1" mnemonicParsing="false" prefHeight="33.0" prefWidth="146.0" text="Agregar Incomp" />
                                <Button fx:id="btnSearch" mnemonicParsing="false" prefHeight="33.0" prefWidth="100.0" text="Buscar" />
                                <Button fx:id="btnClean" mnemonicParsing="false" prefHeight="33.0" prefWidth="100.0" text="Limpiar" />
                            </children>
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                        </HBox>
                        <Label fx:id="lblError" prefHeight="17.0" prefWidth="200.0" styleClass="label-error" text="" textFill="#ff0000" />
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
