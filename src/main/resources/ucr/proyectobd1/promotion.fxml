<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="850.0" styleClass="root-container" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ucr.proyectobd1.controller.PromotionController">
   <children>
      <VBox prefHeight="630.0" prefWidth="830.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="65.0" prefWidth="772.0" spacing="100.0">
               <children>
                  <ImageView fx:id="imageviewLogo" fitHeight="150.0" fitWidth="193.0" pickOnBounds="true" preserveRatio="true" />
                  <Label alignment="CENTER" prefHeight="44.0" prefWidth="282.0" styleClass="label-header" text="CRUD PROMOCIÓN" />
                  <Button fx:id="btnBackMenu" mnemonicParsing="false" prefHeight="33.0" prefWidth="98.0" text="Volver" />
               </children>
            </HBox>
            
            <HBox spacing="20.0" VBox.vgrow="ALWAYS">
               <children>
                  <!-- Formulario -->
                  <VBox prefWidth="300.0" spacing="10.0">
                     <children>
                        <Label text="Código:" />
                        <TextField fx:id="txtCode" />
                        
                        <Label text="Nombre:" />
                        <TextField fx:id="txtName" />
                        
                        <Label text="Descripción:" />
                        <TextArea fx:id="txtDescription" prefHeight="60.0" />
                        
                        <Label text="Fecha Inicial:" />
                        <DatePicker fx:id="dpIDate" prefWidth="300.0" />
                        
                        <Label text="Fecha Final:" />
                        <DatePicker fx:id="dpFDate" prefWidth="300.0" />
                        
                        <Label text="% Descuento:" />
                        <TextField fx:id="txtPDiscount" />
                        
                        <Label text="Tipo Promoción (Cód):" />
                        <TextField fx:id="txtTypePromotion" />
                        
                        <Label fx:id="lblError" textFill="RED" wrapText="true" />
                        
                        <HBox spacing="10.0">
                           <children>
                              <Button fx:id="btnNew" mnemonicParsing="false" text="Nuevo" />
                              <Button fx:id="btnSave" mnemonicParsing="false" text="Guardar" />
                              <Button fx:id="btnEdit" mnemonicParsing="false" text="Editar" />
                              <Button fx:id="btnDelete" mnemonicParsing="false" text="Eliminar" />
                           </children>
                        </HBox>
                        <HBox spacing="10.0">
                           <children>
                              <Button fx:id="btnSearch" mnemonicParsing="false" text="Buscar por Cód." />
                              <Button fx:id="btnClear" mnemonicParsing="false" text="Limpiar" />
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
                  
                  <!-- Tabla -->
                  <VBox prefWidth="510.0" HBox.hgrow="ALWAYS">
                     <children>
                        <TableView fx:id="tableviewPromotions" prefHeight="480.0" prefWidth="510.0" VBox.vgrow="ALWAYS">
                          <columns>
                            <TableColumn fx:id="columnCode" prefWidth="70.0" text="CÓDIGO" />
                            <TableColumn fx:id="columnName" prefWidth="100.0" text="NOMBRE" />
                            <TableColumn fx:id="columnDescription" prefWidth="120.0" text="DESCRIPCIÓN" />
                            <TableColumn fx:id="columnIDate" prefWidth="80.0" text="FECHA I." />
                            <TableColumn fx:id="columnFDate" prefWidth="80.0" text="FECHA F." />
                            <TableColumn fx:id="columnPDiscount" prefWidth="60.0" text="% DESC" />
                            <TableColumn fx:id="columnTypePromotion" prefWidth="90.0" text="TIPO PROM." />
                          </columns>
                        </TableView>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
