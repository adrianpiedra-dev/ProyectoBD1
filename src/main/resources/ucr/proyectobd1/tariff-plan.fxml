<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="850.0" styleClass="root-container" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ucr.proyectobd1.controller.TariffPlanController">
    <children>
        <VBox prefHeight="630.0" prefWidth="830.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="65.0" prefWidth="772.0" spacing="100.0">
                    <children>
                        <ImageView fx:id="imageviewLogo" fitHeight="150.0" fitWidth="193.0" pickOnBounds="true" preserveRatio="true" />
                        <Label alignment="CENTER" prefHeight="44.0" prefWidth="350.0" styleClass="label-header" text="CRUD PLAN TARIFARIO" />
                        <Button fx:id="btnBackMenu" mnemonicParsing="false" prefHeight="33.0" prefWidth="123.0" text="Volver" />
                    </children>
                </HBox>
                <VBox prefHeight="440.0" prefWidth="948.0" spacing="15.0" VBox.vgrow="ALWAYS">
                    <children>
                  <VBox alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT" prefHeight="200.0" prefWidth="100.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="42.0" prefWidth="770.0" spacing="20.0">
                           <children>
                              <Label text="Código: " />
                              <TextField fx:id="lblCode" />
                              <Label text="Nombre:" />
                              <TextField fx:id="lblName" />
                              <Label text="Descripción: " />
                              <TextField fx:id="lblDescription" prefHeight="35.0" prefWidth="154.0" />
                           </children>
                           <padding>
                              <Insets bottom="5.0" />
                           </padding>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" prefHeight="42.0" prefWidth="770.0" spacing="20.0">
                           <children>
                              <Label text="Cuota (M): " />
                              <TextField fx:id="lblCuota" prefHeight="35.0" prefWidth="149.0" />
                              <Label prefHeight="17.0" prefWidth="63.0" text="Gigabites:" />
                              <TextField fx:id="lblGigabites" prefHeight="35.0" prefWidth="150.0" />
                              <Label text="Minutos" />
                              <TextField fx:id="lblMinutes" prefHeight="35.0" prefWidth="179.0" />
                           </children>
                           <padding>
                              <Insets bottom="5.0" />
                           </padding>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" prefHeight="42.0" prefWidth="770.0" spacing="20.0">
                           <children>
                              <Label prefWidth="69.0" text="Mensajes" />
                              <TextField fx:id="lblMS" prefHeight="35.0" prefWidth="145.0" />
                              <Label text="Costo" />
                              <TextField fx:id="lblCost" prefHeight="35.0" prefWidth="179.0" />
                              <Label text="Código CC" />
                              <ComboBox fx:id="comboboxCodeCC" prefHeight="35.0" prefWidth="163.0" />
                           </children>
                           <padding>
                              <Insets bottom="5.0" />
                           </padding>
                        </HBox>
                     </children>
                  </VBox>
                        <HBox alignment="CENTER" prefHeight="50.0" prefWidth="200.0" spacing="10.0">
                            <children>
                                <Button fx:id="btnSave" mnemonicParsing="false" prefHeight="33.0" prefWidth="100.0" text="Crear" />
                                <Button fx:id="btnDelete" mnemonicParsing="false" prefHeight="33.0" prefWidth="100.0" text="Eliminar" />
                        <Button fx:id="btnUpdate" mnemonicParsing="false" prefHeight="33.0" prefWidth="117.0" text="Actualizar" />
                                <Button fx:id="btnSearch" mnemonicParsing="false" prefHeight="33.0" prefWidth="100.0" text="Buscar" />
                                <Button fx:id="btnClean" mnemonicParsing="false" prefHeight="33.0" prefWidth="100.0" text="Limpiar" />
                            </children>
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                        </HBox>
                        <Label fx:id="lblError" prefHeight="17.0" prefWidth="200.0" styleClass="label-error" text="" textFill="#ff0000" />
                        <TableView fx:id="tableViewPT" prefHeight="170.0" prefWidth="826.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="columnCode" prefWidth="150.0" text="Código" />
                                <TableColumn fx:id="columnName" prefWidth="150.0" text="Nombre" />
                                <TableColumn fx:id="columnDescription" prefWidth="150.0" text="Descripción" />
                                <TableColumn fx:id="columnCuute" prefWidth="150.0" text="Cuota" />
                        <TableColumn fx:id="columnGB" prefWidth="75.0" text="Gigabites" />
                        <TableColumn fx:id="columnMinutes" prefWidth="75.0" text="Minutos" />
                        <TableColumn fx:id="columnMS" prefWidth="75.0" text="Mensajes" />
                        <TableColumn fx:id="columnCost" prefWidth="75.0" text="Costos" />
                        <TableColumn fx:id="columnCodeCC" prefWidth="75.0" text="Código CC" />
                            </columns>
                        </TableView>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
